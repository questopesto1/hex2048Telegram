(function(){
  const saved=localStorage.getItem('hex2048_theme');
  if(saved){applyTheme(saved);return}
  try{const bg=window.Telegram?.WebApp?.themeParams?.bg_color||'';if(bg&&/^#[0-3]/i.test(bg)){applyTheme('dark');return}if(bg){applyTheme('light');return}}catch(e){}
  applyTheme(window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');
})();
initSupabase();
let started=false;
for(const r of [2,3,4,5,6]){if(localStorage.getItem(sessionKey(r))){radiusSelect.value=String(r);if(loadSessionForRadius(r)){started=true;break}}}
if(!started){buildGrid(2);newGame()}
window.addEventListener('load',()=>{setTimeout(forceRecalcLayout,100);setTimeout(forceRecalcLayout,500);setTimeout(forceRecalcLayout,1500)});
</script>
