<style>
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{width:100%;height:100%;overflow:hidden;overscroll-behavior:none;position:fixed;top:0;left:0;right:0;bottom:0;margin:0;padding:0}
  body{font-family:'Segoe UI',system-ui,-apple-system,sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;user-select:none;-webkit-user-select:none;padding-top:max(env(safe-area-inset-top),10px);padding-bottom:max(env(safe-area-inset-bottom),10px);padding-left:8px;padding-right:8px;min-height:100vh;min-height:100dvh;height:100%;transition:background .3s,color .3s}
  h1{font-size:1.8rem;margin:.2em 0;flex-shrink:0;font-weight:800}
  .header{display:flex;align-items:center;gap:.4em;margin-bottom:.3em;flex-wrap:wrap;justify-content:center;flex-shrink:0}
  .score-box{border-radius:8px;padding:.2em .6em;text-align:center;min-width:55px;border:2px solid}
  .score-box .label{font-size:.5rem;text-transform:uppercase;letter-spacing:1px;opacity:.6}
  .score-box .value{font-size:1.1rem;font-weight:bold}
  .diff-select{border:2px solid;padding:.2em .4em;border-radius:6px;font-size:.75rem;cursor:pointer;outline:none}
  .btn{border:none;color:#fff;font-size:.75rem;font-weight:bold;padding:.3em .8em;border-radius:6px;cursor:pointer;transition:transform .15s}
  .btn:active{transform:scale(.95)}
  .btn-share{margin-bottom:.5em}
  .icon-btn{width:32px;height:32px;border-radius:6px;border:2px solid;font-size:1rem;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:opacity .3s}
  .icon-btn:active{transform:scale(.9)}.icon-btn.muted{opacity:.5}.icon-btn.active{color:#fff}
  #game-wrapper{flex:1;width:100%;min-height:0;overflow:hidden;display:flex;align-items:center;justify-content:center}
  #game-container{position:relative;flex-shrink:0}
  #grid-layer,#tiles-layer{position:absolute;inset:0;pointer-events:none}
  #grid-layer{z-index:0}#tiles-layer{z-index:1}
  .hex{position:absolute;width:70px;height:60.62px;clip-path:polygon(25% 0%,75% 0%,100% 50%,75% 100%,25% 100%,0% 50%);display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:800;line-height:1;transition:left .18s ease-out,top .18s ease-out;z-index:2;-webkit-font-smoothing:antialiased}
  .hex.empty{z-index:0;opacity:.3}
  .hex.tile{z-index:2}
  .hex.new-tile{animation:tileAppear .3s ease-out}
  .hex.merged-tile{animation:tileMerge .3s ease-out}
  .hex.neighbor-merged{animation:tileNeighborMerge .35s ease-out}
  .hex.consumed-neighbor{animation:tileShatter .25s ease-out forwards}
  @keyframes tileAppear{0%{transform:scale(0);opacity:0}100%{transform:scale(1);opacity:1}}
  @keyframes tileMerge{0%{transform:scale(1)}30%{transform:scale(1.2)}100%{transform:scale(1)}}
  @keyframes tileNeighborMerge{0%{transform:scale(1)}25%{transform:scale(1.25)}50%{transform:scale(.95)}100%{transform:scale(1)}}
  @keyframes tileShatter{0%{transform:scale(1);opacity:1}100%{transform:scale(0);opacity:0}}
  .spark{position:absolute;width:5px;height:5px;border-radius:50%;pointer-events:none;z-index:10;animation:sparkFly .5s ease-out forwards}
  @keyframes sparkFly{0%{transform:translate(-50%,-50%) scale(1);opacity:1}100%{transform:translate(calc(-50% + var(--dx)),calc(-50% + var(--dy))) scale(0);opacity:0}}
  .mobile-controls{display:none;margin-top:.3em;gap:3px;grid-template-columns:repeat(3,var(--btn-size,48px));grid-template-rows:repeat(2,var(--btn-size,48px));justify-content:center;align-items:center;flex-shrink:0}
  .mobile-controls button{width:var(--btn-size,48px);height:var(--btn-size,48px);font-size:1rem;border:2px solid;border-radius:8px;cursor:pointer;display:flex;align-items:center;justify-content:center;touch-action:manipulation}
  .mobile-controls button:active{transform:scale(.92)}
  .mc-up{grid-column:2;grid-row:1}.mc-nw{grid-column:1;grid-row:1}.mc-ne{grid-column:3;grid-row:1}
  .mc-sw{grid-column:1;grid-row:2}.mc-down{grid-column:2;grid-row:2}.mc-se{grid-column:3;grid-row:2}
  .overlay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:100;border-radius:16px;opacity:0;pointer-events:none;transition:opacity .35s;padding:1.5em}
  .overlay.active{opacity:1;pointer-events:all}
  .overlay h2{font-size:1.6rem;margin-bottom:.3em;font-weight:800}
  .overlay p{font-size:.9rem;margin-bottom:.7em;text-align:center;opacity:.6}
  #nickname-form{display:none;align-items:center;gap:.4em;margin-bottom:.8em}
  #nickname-input{padding:.35em .5em;border-radius:6px;border:2px solid;font-size:.9rem;width:140px;text-align:center;outline:none;touch-action:auto}
  .lb-container{width:280px;max-height:220px;overflow-y:auto;border-radius:8px;padding:.4em;font-size:.8rem;margin-bottom:.7em;overscroll-behavior:contain;border:1px solid}
  .lb-tabs{display:flex;gap:4px;margin-bottom:.4em}
  .lb-tab{flex:1;padding:.3em;border-radius:6px;border:2px solid;font-size:.7rem;font-weight:bold;cursor:pointer;text-align:center;transition:all .2s;background:transparent}
  .lb-tab.active{color:#fff}
  .lb-header{display:flex;justify-content:space-between;border-bottom:1px solid;padding:.25em .4em;opacity:.5;margin-bottom:.15em}
  .lb-row{display:flex;justify-content:space-between;padding:.25em .4em;border-radius:4px}
  .lb-row:hover{opacity:.8}.lb-row.top1{font-weight:bold}
  .lb-row.me{border:2px solid}
  .lb-loading,.lb-empty{text-align:center;padding:.8em;opacity:.5}
  @media(hover:none) and (pointer:coarse){.mobile-controls{display:grid}}
  @media(max-width:600px){h1{font-size:1.4rem;margin:.15em 0}.header{gap:.3em;margin-bottom:.2em}.score-box{padding:.15em .4em;min-width:45px}.score-box .value{font-size:1rem}.mobile-controls{--btn-size:40px;gap:2px;margin-top:.2em}}
  @media(max-height:700px){h1{font-size:1.3rem;margin:.1em 0}.header{margin-bottom:.15em}.mobile-controls{--btn-size:36px;gap:2px;margin-top:.1em}}
  @media(max-height:600px){.mobile-controls{--btn-size:32px;gap:1px;margin-top:.05em}.mobile-controls button{font-size:.85rem;border-width:1px}}
</style>
